# Copy this file to .env (or export these in your shell) before running
# skills-server. The server refuses to start if SUBMITTER_TOKEN, ADMIN_TOKEN,
# GITHUB_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URL,
# or ADMIN_EMAILS are unset/empty -- there is no insecure default.

# Shared secret required in the X-Submitter-Token header on
# POST /api/v1/submissions. Give this to whoever/whatever submits skills.
SUBMITTER_TOKEN=

# Shared secret required in the X-Admin-Token header on the
# /api/v1/admin/* endpoints.
ADMIN_TOKEN=

# GitHub personal access token with `repo` scope on GITHUB_REPO. Used to
# publish approved skills via the Contents API.
GITHUB_TOKEN=

# "owner/name" of the private GitHub repo used as the durable artifact
# store for published skills.
GITHUB_REPO=nanoinfraorg/skills

# Path to the SQLite database file. Created on startup if missing.
DB_PATH=./data/skills-server.db

# Where uploaded (pending-review) zip archives are stored on local disk.
SUBMISSIONS_DIR=./data/submissions

# Where the validated zip archives of published skills are archived
# locally so the download endpoint can serve them without hitting GitHub
# on every request.
PUBLISHED_DIR=./data/published

# TCP port the HTTP server listens on.
PORT=8080

# Optional: base URL, API key, and model name for the security scan
# shield's LLM classification pass (see internal/scan). All three must be
# set together for the LLM pass to run; if any is empty it is skipped
# entirely and never blocks a scan from completing. LLM_API_BASE should
# point at an OpenAI-compatible /chat/completions endpoint (no trailing
# /chat/completions -- that's appended automatically).
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Optional: how often the daily re-scan scheduler (internal/scheduler)
# re-scans every published skill's current version, as a Go duration
# string (e.g. "24h", "30m"). Defaults to 24h.
DAILY_SCAN_INTERVAL=24h

# "Sign in with Google" -- a second, parallel way to authenticate as admin
# or submitter (alongside SUBMITTER_TOKEN/ADMIN_TOKEN above), using the
# full server-side OAuth Authorization Code flow with session cookies.
#
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and GOOGLE_REDIRECT_URL must be
# created by *you*, the operator, in Google Cloud Console -- this is a
# manual, human, external setup step; the server cannot do this for you:
#   1. https://console.cloud.google.com/apis/credentials
#   2. "Create Credentials" -> "OAuth client ID" -> Application type "Web
#      application"
#   3. Add GOOGLE_REDIRECT_URL below as an "Authorized redirect URI"
#   4. Copy the generated client ID and client secret here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI registered on the OAuth
# client above. For local dev this is plain http:// (no TLS); GET
# /auth/google/callback only sets the Secure cookie attribute when the
# request itself arrived over TLS, so plain-http local dev still works.
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Comma-separated allowlist of Google account emails (case-insensitive)
# that receive the admin role when they sign in with Google. Required --
# there is no "anyone is an admin" default.
ADMIN_EMAILS=

# Optional, comma-separated allowlist of Google account emails
# (case-insensitive) that receive the submitter role when they sign in
# with Google. If unset/empty, *any* Google account with a verified email
# may authenticate as a submitter -- this is intentionally permissive: a
# submission only ever reaches "pending" and never publishes anything by
# itself, so opening submission up to any real, Google-verified human is
# judged an acceptable default. Set this to restrict submission to a
# specific list, same as ADMIN_EMAILS.
SUBMITTER_EMAILS=

# Optional: how long a Google-OAuth-issued session cookie remains valid,
# as a Go duration string. Defaults to 24h.
SESSION_TTL=24h
